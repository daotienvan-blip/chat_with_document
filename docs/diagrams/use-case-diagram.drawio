  <diagram id="usecase-catalog" name="Danh mục Use Case"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cat" value='&lt;div style="font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#1A1A1A;"&gt;&lt;h2 style="margin:0 0 8px 0;"&gt;Danh mục use case — “Chat với tài liệu” (MVP)&lt;/h2&gt;&lt;table style="border-collapse:collapse;width:100%;"&gt;&lt;tr&gt;&lt;th style="border:1px solid #BDBDBD;padding:6px 8px;background:#ECEFF1;text-align:left;"&gt;ID&lt;/th&gt;&lt;th style="border:1px solid #BDBDBD;padding:6px 8px;background:#ECEFF1;text-align:left;"&gt;Use case&lt;/th&gt;&lt;th style="border:1px solid #BDBDBD;padding:6px 8px;background:#ECEFF1;text-align:left;"&gt;Actor liên quan&lt;/th&gt;&lt;th style="border:1px solid #BDBDBD;padding:6px 8px;background:#ECEFF1;text-align:left;"&gt;Quan hệ&lt;/th&gt;&lt;th style="border:1px solid #BDBDBD;padding:6px 8px;background:#ECEFF1;text-align:left;"&gt;User story (PRD)&lt;/th&gt;&lt;th style="border:1px solid #BDBDBD;padding:6px 8px;background:#ECEFF1;text-align:left;"&gt;Yêu cầu (BRD)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC01&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Cấp / thu hồi quyền truy cập&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Quản trị viên (UC-P3)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;—&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-013&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-014&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC02&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Xem nhật ký truy cập&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Quản trị viên (UC-P3)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;—&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-017&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-021&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC03&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Thiết lập chính sách lưu trữ &amp;amp; lưu giữ&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Đại diện CNTT / bảo mật (UC-P4)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;—&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-015, US-016&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-016, BR-019&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC04&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Đăng nhập&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Người dùng kinh doanh (UC-P1, UC-P2)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;include UC05, UC06&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-013&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-014&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC05&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Xác thực danh tính&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Dịch vụ xác thực (IF-01)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;được include bởi UC04&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-013&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-014&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC06&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Kiểm tra quyền truy cập&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;(hệ thống)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;được include bởi UC04&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-013, US-014&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-014, BR-015&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC07&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Tải PDF lên&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Người dùng kinh doanh&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;include UC08, UC09; extend bởi UC10&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-001&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-001, BR-005&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC08&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Kiểm tra file (định dạng, kích thước)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;(hệ thống)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;được include bởi UC07&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-001 (AC2, AC3)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-005, BRU-003&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC09&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Xử lý &amp;amp; lưu trữ tài liệu, báo sẵn sàng&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Kho lưu trữ tài liệu (IF-03)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;được include bởi UC07&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-002&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-002, BR-016&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC10&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Báo lỗi tải lên và nêu lý do&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;(hệ thống)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;extend UC07 — khi file không hợp lệ / hỏng / có mật khẩu / ảnh quét / mất kết nối&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-003&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-018&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC11&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Xem danh sách tài liệu &amp;amp; trạng thái&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Người dùng kinh doanh&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;—&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-004&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-003&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC12&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Xóa tài liệu&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Người dùng kinh doanh&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC13 là chuyên biệt hóa (generalization)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-005&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-004&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC13&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Xóa tài liệu quá hạn lưu giữ (tự động)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Kho lưu trữ tài liệu (IF-03)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;generalization: UC13 → UC12&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-016&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-019&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC14&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Đặt câu hỏi bằng ngôn ngữ tự nhiên&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Người dùng kinh doanh&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;include UC15, UC21; extend bởi UC18, UC19, UC20&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-006&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-006&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC15&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Hiển thị nguồn trích dẫn&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;(hệ thống)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;được include bởi UC14; extend bởi UC16, UC17&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-007&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-007&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC16&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Hiển thị số trang của nguồn&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;(hệ thống)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;extend UC15 — khi xác định được vị trí trong tài liệu&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-008&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-008&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC17&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Mở tài liệu nguồn để đối chiếu&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Người dùng kinh doanh&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;extend UC15 — khi người dùng muốn kiểm chứng&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;PRD §2.2&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-008&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC18&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Tổng hợp từ nhiều tài liệu&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;(hệ thống)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;extend UC14 — khi câu hỏi cần ≥ 2 tài liệu&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-009&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-009&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC19&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Báo không tìm thấy thông tin&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;(hệ thống)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;extend UC14 — khi tập tài liệu không có căn cứ&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-010&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-010&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC20&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Hỏi tiếp nối trong cùng cuộc trao đổi&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Người dùng kinh doanh&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;extend UC14 — khi câu hỏi tham chiếu ngữ cảnh trước&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-011&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-013&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC21&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Truy xuất nội dung &amp;amp; sinh câu trả lời&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Dịch vụ AI bên ngoài (IF-02)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;được include bởi UC14&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-006, US-007&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-006, BR-007&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC22&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Xem số liệu sử dụng &amp;amp; hiệu quả MVP&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Quản lý / Sponsor (UC-P5)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;include UC23&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-018&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-017&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC23&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Tổng hợp chỉ số MET-001…003&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Hệ thống phân tích (IF-05)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;được include bởi UC22&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;US-018&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-017&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;UC24&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Ghi nhận sự kiện sử dụng&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;Hệ thống phân tích (IF-05)&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;—&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;PRD §5.2&lt;/td&gt;&lt;td style="border:1px solid #BDBDBD;padding:4px 8px;vertical-align:top;"&gt;BR-017&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style="margin:10px 0 4px 0;"&gt;&lt;b&gt;Ghi chú&lt;/b&gt;&lt;/p&gt;&lt;ul style="margin:0;padding-left:18px;"&gt;&lt;li&gt;UC-P1…P5 là nhóm người dùng theo BRD §6.1; IF-01…IF-05 là giao diện hệ thống theo PRD §4.3.&lt;/li&gt;&lt;li&gt;Chưa mô hình hóa vì là yêu cầu phi chức năng / cổng phát hành: US-012 (thời gian phản hồi), US-019 (sẵn sàng), BR-011 (độ chính xác).&lt;/li&gt;&lt;li&gt;Hệ thống AI bên ngoài (IF-02), kho lưu trữ (IF-03) và hệ thống phân tích (IF-05) chưa được quyết định có dùng hay không (OQ-005) — vẽ theo giả định có.&lt;/li&gt;&lt;li&gt;Mô hình chia sẻ tài liệu giữa người dùng chưa chốt (OQ-006) nên chưa có use case chia sẻ.&lt;/li&gt;&lt;li&gt;Mọi use case của người dùng yêu cầu đã đăng nhập (UC04); không vẽ include riêng để tránh đường chồng chéo.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;' style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1360" height="1150" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
