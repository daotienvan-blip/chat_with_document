cwd-prod-api-1: user=10001 read_only=true security_opt=[no-new-privileges:true]
cwd-prod-api-2: user=10001 read_only=true security_opt=[no-new-privileges:true]
cwd-prod-worker-1: user=10001 read_only=true security_opt=[no-new-privileges:true]
cwd-prod-proxy-1: user=101 read_only=true security_opt=[no-new-privileges:true]
worker nối mạng cwd-prod_data: internal=true
