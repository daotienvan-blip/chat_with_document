$ ok=1
for p in / /api/v1/config; do
  H=$(curl -sS -D - -o /dev/null --cacert var/prod-local/certs/tls.crt "https://localhost:8443$p" | tr -d '\r')
  echo "== GET $p"; echo "$H"
  grep -qi '^strict-transport-security:' <<<"$H" || ok=0
done
[[ $ok == 1 ]] && echo "Có Strict-Transport-Security" || { echo "KHÔNG có tiêu đề Strict-Transport-Security"; exit 1; }
