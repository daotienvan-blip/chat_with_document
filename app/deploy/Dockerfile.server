# S8-05 — ảnh cho api, worker và migrate. Chạy bằng uid 10001.
FROM python:3.12-slim AS build
WORKDIR /src
COPY app/server/pyproject.toml ./
COPY app/server/cwd_server ./cwd_server
RUN pip install --no-cache-dir --prefix=/install '.[s3]'

FROM python:3.12-slim
RUN useradd --uid 10001 --create-home app
COPY --from=build /install /usr/local
WORKDIR /app/server
COPY app/server/cwd_server ./cwd_server
COPY app/server/alembic.ini ./
COPY docs/04-design/schema.sql /app/docs/04-design/schema.sql
ENV SCHEMA_SQL=/app/docs/04-design/schema.sql WEB_DIST=/nonexistent PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001
EXPOSE 8000
CMD ["uvicorn", "cwd_server.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-graceful-shutdown", "45"]
