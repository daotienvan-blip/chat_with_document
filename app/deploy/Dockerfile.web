# S8-05 — build SPA rồi phục vụ bằng nginx (proxy S8-06), chạy không root (uid 101), cổng 8443.
FROM node:22-alpine AS build
WORKDIR /src
COPY app/web/package*.json ./
RUN npm ci --no-audit --no-fund
COPY app/web ./
COPY docs/04-design/openapi.yaml /docs/04-design/openapi.yaml
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
COPY app/deploy/proxy/nginx.conf /etc/nginx/nginx.conf
COPY app/deploy/proxy/proxy_common.conf /etc/nginx/proxy_common.conf
COPY app/deploy/proxy/allowlist.conf /etc/nginx/allowlist.conf
EXPOSE 8443
