# Bí mật lấy từ bộ quản lý bí mật của nền tảng; không commit tệp env.prod.
# Dùng cho cả nội suy compose (--env-file) và env_file của container.
# Lưu ý: env_file của Docker KHÔNG bỏ chú thích cuối dòng — chỉ viết chú thích trên dòng riêng.
DATABASE_URL_MIGRATE=postgresql+psycopg://cwd_owner:***@db/cwd
DATABASE_URL_API=postgresql+psycopg://cwd_api_login:***@db/cwd
DATABASE_URL_WORKER=postgresql+psycopg://cwd_worker_login:***@db/cwd
# Thư mục chứa tls.crt/tls.key (mount chỉ-đọc vào proxy) và cổng HTTPS trên máy chủ
TLS_DIR=./certs
PROXY_PORT=443
OBJECT_STORE=s3
S3_ENDPOINT=https://s3.internal
S3_BUCKET=cwd-documents
S3_ACCESS_KEY=***
S3_SECRET_KEY=***
# Chỉ đặt http sau khi OQ-005 cho phép gửi nội dung tới dịch vụ AI; worker khi đó cần đường ra tới IF-02.
LLM_PROVIDER=http
LLM_BASE_URL=
LLM_API_KEY=
LLM_EMBED_MODEL=
LLM_CHAT_MODEL=
# [TBD: OQ-S01]
EMBEDDING_DIM=
