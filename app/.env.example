# Cấu hình demo cục bộ. Giá trị [TBD] để trống = chưa quyết định (xem docs/05-implement/PLAN.md §8).
DATABASE_URL=postgresql+psycopg:///cwd
OBJECT_STORE=local
LLM_PROVIDER=extractive
EMBEDDING_DIM=384
# Dùng stack Docker của `make up` (S0-02) thay cho PostgreSQL Homebrew + kho tệp cục bộ:
# DATABASE_URL=postgresql+psycopg://cwd:cwd@localhost:5433/cwd
# TEST_DATABASE_URL=postgresql+psycopg://cwd:cwd@localhost:5433/cwd_test
# OBJECT_STORE=s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=cwd-documents
# S3_ACCESS_KEY=cwd
# S3_SECRET_KEY=cwd-dev-secret
# S3_REGION=us-east-1
# MAX_FILE_SIZE_MB=        # [TBD: OQ-009] — đang dùng HARD_MAX_UPLOAD_MB=200
# MAX_QUESTION_LENGTH=     # [TBD: OQ-P06] — đang dùng HARD_MAX_QUESTION_CHARS=4000
# MAX_QUESTION_LENGTH=     # [TBD: OQ-P06]
# Bật AI thật (chỉ khi OQ-005 cho phép):
# LLM_PROVIDER=http
# LLM_BASE_URL=https://.../v1
# LLM_API_KEY=...
# LLM_EMBED_MODEL=...
# LLM_CHAT_MODEL=...
