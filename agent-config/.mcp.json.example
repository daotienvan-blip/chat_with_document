{
  "mcpServers": {
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${CWD_GITHUB_PAT}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,actions",
        "X-MCP-Lockdown": "true"
      }
    },
    "atlassian": {
      "type": "http",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "oauth": {
        "scopes": "read:me read:account email read:jira:agent-interface write:jira:agent-interface search:jira:agent-interface"
      }
    }
  }
}
